FROM python:3.15-slim-bookworm AS test-runner

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PIP_ROOT_USER_ACTION=ignore

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    libtbb12 \
    curl \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt pytest pytest-asyncio httpx2 pytest-playwright && \
    playwright install --with-deps chromium

ENV PYTHONPATH=/app/src

COPY pyproject.toml ./
COPY src/ ./src/
COPY tests/ ./tests/
COPY static/ ./static/
COPY firmware/bin/firmware_sketch.ino.bin ./flash/
COPY training/runs/latest/weights/ ./weights/
